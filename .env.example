# ─────────────────────────────────────────────────────────────
#  Werewolf Online — Environment Variables
#  Copy file này thành .env và chỉnh lại cho máy của bạn
#
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=werewolf
POSTGRES_PASSWORD=werewolf123
POSTGRES_DB=werewolf

# ─── Dùng khi CHẠY SERVICE LOCAL (ngoài Docker) ───
# Kafka external listener
KAFKA_BROKER=localhost:9094
# Redis local
REDIS_URL=redis://localhost:6379
# PostgreSQL local
DATABASE_URL=postgresql://werewolf:werewolf123@localhost:5436/werewolf

# ─── Dùng khi CHẠY SERVICE TRONG DOCKER ───
# KAFKA_BROKER=kafka:9092
# REDIS_URL=redis://redis:6379
# DATABASE_URL=postgresql://werewolf:werewolf123@postgres:5436/werewolf
