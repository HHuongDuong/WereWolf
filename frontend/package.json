{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:full": "bun run tw:watch & bun run dev",
    "tw:build": "bunx tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tw.css",
    "tw:watch": "bunx tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tw.css --watch",
    "build": "bun run tw:build && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.14.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.2.2"
  }
}
